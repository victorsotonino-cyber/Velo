# DATASHOP — copia a .env localmente o configura estas variables en el hosting.
# Nunca publiques .env ni compartas DISCORD_TOKEN.
DISCORD_TOKEN=
GUILD_ID=
BOT_PREFIX=!
PORT=10000
DATASHOP_DATA_DIR=./data
STORE_CURRENCY=USD

# IDs opcionales para configurar valores predeterminados
WELCOME_CHANNEL_ID=
LOGS_CHANNEL_ID=
TICKETS_CATEGORY_ID=
STAFF_ROLE_ID=
MEMBER_ROLE_ID=
