# Copia como .env. Nunca subas el .env real a GitHub.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
BOT_PREFIX=!

# Canales de Discord (IDs configurados por el administrador)
WELCOME_CHANNEL_ID=
TERMS_CHANNEL_ID=
PAYMENT_METHODS_CHANNEL_ID=
TICKETS_INFO_CHANNEL_ID=
LOGS_CHANNEL_ID=
TICKETS_CATEGORY_ID=
ANNOUNCEMENTS_CHANNEL_ID=

# Roles de Discord
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
MEMBER_ROLE_ID=

# IDs de emojis personalizados para el panel de tickets
TICKET_EMOJI_COMPRAS_ID=
TICKET_EMOJI_DUDAS_ID=
TICKET_EMOJI_REPORTES_ID=
TICKET_EMOJI_PARTNER_ID=
TICKET_EMOJI_ALLY_ID=

# Tienda
STORE_CURRENCY=USD
STORE_PAYMENT_METHODS=PayPal,Binance Pay,Transferencia bancaria,Pago movil
STORE_PAYMENT_INSTRUCTIONS=

# Ajustes de tickets y almacenamiento
MAX_TICKETS_PER_USER=2
VELO_DATA_DIR=

# Automoderación (para los módulos que la usan)
AUTOMOD_ENABLED=true
AUTOMOD_MAX_MESSAGES=5
AUTOMOD_WINDOW_SECONDS=7
AUTOMOD_TIMEOUT_MINUTES=5
