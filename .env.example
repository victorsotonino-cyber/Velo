# DATASHOP — copia a .env en local o define estas variables en el hosting.
# Nunca publiques .env ni compartas DISCORD_TOKEN.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
BOT_PREFIX=!
PORT=3000

# Identificadores opcionales del servidor (rellenar al añadir cada módulo)
WELCOME_CHANNEL_ID=
LOGS_CHANNEL_ID=
TICKETS_CATEGORY_ID=
ANNOUNCEMENTS_CHANNEL_ID=
TERMS_CHANNEL_ID=
PAYMENT_METHODS_CHANNEL_ID=
TRANSACTIONS_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
REVIEWS_CHANNEL_ID=
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
MEMBER_ROLE_ID=

# Tienda
STORE_CURRENCY=USD
DATASHOP_DATA_DIR=./data
