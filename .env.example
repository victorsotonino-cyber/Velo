# Copia este archivo a .env y rellena los valores en tu hosting.
# Nunca publiques .env ni compartas DISCORD_TOKEN.
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=
BOT_PREFIX=!

# Canales del servidor (configura los IDs solo en tu .env privado)
WELCOME_CHANNEL_ID=
LOGS_CHANNEL_ID=
TICKETS_CATEGORY_ID=
ANNOUNCEMENTS_CHANNEL_ID=
TERMS_CHANNEL_ID=
PAYMENT_METHODS_CHANNEL_ID=
TICKET_INFO_CHANNEL_ID=
SUGGESTIONS_CHANNEL_ID=
REVIEWS_CHANNEL_ID=

# Roles del servidor
ADMIN_ROLE_ID=
STAFF_ROLE_ID=
MEMBER_ROLE_ID=

# Emojis personalizados del panel de tickets
TICKET_EMOJI_COMPRAS_ID=
TICKET_EMOJI_COMPRAS_NAME=emoji_20
TICKET_EMOJI_DUDAS_ID=
TICKET_EMOJI_DUDAS_NAME=emoji_138
TICKET_EMOJI_REPORTES_ID=
TICKET_EMOJI_REPORTES_NAME=emoji_139
TICKET_EMOJI_PARTNER_ID=
TICKET_EMOJI_PARTNER_NAME=flux_pandahiyapolice_2219
TICKET_EMOJI_ALLY_ID=
TICKET_EMOJI_ALLY_NAME=flux_owner_4264

# Tienda
STORE_CURRENCY=USD
MAX_TICKETS_PER_USER=2
TICKET_CLOSE_DELAY_MS=5000
VELO_DATA_DIR=./data

# AutoMod básico
AUTOMOD_ENABLED=true
AUTOMOD_MAX_MESSAGES=6
AUTOMOD_WINDOW_SECONDS=7
AUTOMOD_DUPLICATE_LIMIT=3
AUTOMOD_MAX_MENTIONS=5
AUTOMOD_TIMEOUT_MINUTES=5
AUTOMOD_BLOCK_INVITES=true
